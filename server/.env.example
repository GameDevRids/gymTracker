# Local port; Render sets PORT automatically.
PORT=3001
# Bind to all interfaces on Render; use 127.0.0.1 for local-only development.
HOST=0.0.0.0
# Set to production on Render.
NODE_ENV=production
# Supabase project URL and server-only service-role secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional HTTP Basic Auth password for all routes except /health. Leave empty to disable.
# Any username works. Note: Meta webhooks cannot send it, so leave empty when using live WhatsApp.
DEMO_PASSWORD=
# Optional comma-separated gym IDs treated as demo accounts. Only these can load fictional sample data in Settings.
DEMO_GYM_IDS=
# Optional Sentry project DSN; error tracking is disabled when empty.
SENTRY_DSN=
# Optional Pino log level (trace, debug, info, warn, error, fatal).
LOG_LEVEL=info
# Meta Graph API version; defaults to v22.0.
META_GRAPH_API_VERSION=v22.0
# Meta Cloud API token for live sends; leave empty in demo mode.
WHATSAPP_ACCESS_TOKEN=
# Meta WhatsApp phone number ID used for live sends.
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret used to validate webhook signatures.
WHATSAPP_APP_SECRET=
# Shared token used to verify Meta webhook setup requests.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Comma-separated browser origins allowed to call the WhatsApp send endpoint.
WHATSAPP_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5500,http://127.0.0.1:5500
# Optional disposable demo project seeding; only run with ALLOW_SEED=true.
DEMO_SUPABASE_URL=
DEMO_SUPABASE_SERVICE_ROLE_KEY=
DEMO_GYM_ID=
